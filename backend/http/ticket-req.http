@baseUrl = http://localhost:5000

### login as employee first (run auth-req.http login), then:

### list categories to get a categoryId
GET {{baseUrl}}/meta-api/categories

### create ticket
POST {{baseUrl}}/ticket-api/tickets
Content-Type: application/json

{
  "title": "Laptop won't turn on",
  "description": "Pressed power button, no lights, tried charger swap.",
  "categoryId": "PASTE_CATEGORY_ID"
}

### list my tickets
GET {{baseUrl}}/ticket-api/tickets

### get one ticket
GET {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID

### --- Phase 2: approvals ---

### create a ticket in an approval-required category (login as employee first)
POST {{baseUrl}}/ticket-api/tickets
Content-Type: application/json

{
  "title": "Need a second monitor",
  "description": "Requesting a second monitor for my desk.",
  "categoryId": "PASTE_NEW_HARDWARE_REQUEST_CATEGORY_ID"
}

### login as manager (run auth-req.http with manager@sdp.test), then list pending approvals
GET {{baseUrl}}/ticket-api/tickets?status=PENDING_APPROVAL

### approve it
PATCH {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID/approve
Content-Type: application/json

{}

### ...or reject it (note is required)
PATCH {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID/reject
Content-Type: application/json

{
  "note": "Please use the shared spare-monitor pool instead."
}

### list technicians in your team (manager/admin only)
GET {{baseUrl}}/ticket-api/team-technicians

### put an in-progress ticket on hold (login as the assigned technician)
PATCH {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID/hold
Content-Type: application/json

{
  "note": "Waiting on a replacement part from the vendor."
}

### resume it
PATCH {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID/resume
Content-Type: application/json

{}

### reassign to a different technician (manager/admin)
PATCH {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID/reassign
Content-Type: application/json

{
  "technicianId": "PASTE_OTHER_TECHNICIAN_ID"
}

### --- Phase 3: SLA engine ---

### create a ticket, then immediately downgrade it to the fast "TEST" priority
### to watch it go on-track -> at-risk -> breached in ~1-3 minutes instead
### of waiting on real business hours (login as manager first)
PATCH {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID/priority
Content-Type: application/json

{
  "priority": "TEST"
}

### fetch the ticket a few times over the next few minutes — the "sla"
### object's responseDueAt/resolutionDueAt/warnAt will already be in the
### past, and each fetch triggers the lazy SLA check (see evaluateSla.js)
GET {{baseUrl}}/ticket-api/tickets/PASTE_TICKET_PUBLIC_ID

### check notifications arrived (login as the manager/technician who
### should have been notified)
GET {{baseUrl}}/notification-api/my-notifications

### admin: view/update org-wide business hours
GET {{baseUrl}}/admin-api/org-settings

### admin: e.g. shift business hours to 08:00-20:00
PUT {{baseUrl}}/admin-api/org-settings
Content-Type: application/json

{
  "businessHours": { "start": "08:00", "end": "20:00" }
}

### admin: create a policy with businessHoursOnly explicitly set
POST {{baseUrl}}/admin-api/sla-policies
Content-Type: application/json

{
  "priority": "URGENT",
  "label": "Urgent",
  "level": 5,
  "color": "#dc2626",
  "responseTimeHours": 0.5,
  "resolutionTimeHours": 2,
  "businessHoursOnly": true
}
