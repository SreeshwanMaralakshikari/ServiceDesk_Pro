PORT=5000
MONGO_URI=YOUR_MONGODB_CONNECTION_STRING
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=1d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SEED_ON_START=true

# Phase 6 — optional. Leave blank to run classify-ticket on its offline
# heuristic fallback (no external call, no cost, works out of the box).
# Get a free key at https://console.groq.com if you want the real AI path.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
