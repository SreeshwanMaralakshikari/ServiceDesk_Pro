PORT=5000
# include a database name, and use a separate one per environment
# (e.g. servicedeskpro_dev locally, servicedeskpro_prod on Render)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/servicedeskpro_dev
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=1d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# local only. Ignored when NODE_ENV=production (use `npm run seed` once instead)
SEED_ON_START=false

# production admin created by `npm run seed` (min 12 characters). Demo accounts
# are never created when NODE_ENV=production. Optional SEED_ADMIN_EMAIL.
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@sdp.test

# reverse proxy hops in front of Express, used for rate-limit IPs.
# local: 0 or 1. Live (Vercel rewrite -> Cloudflare -> Render) = 4, verified
# with LOG_CLIENT_IP: req.ip must be the real client address.
TRUST_PROXY_HOPS=1
# temporary: log the client IP seen on each login to verify TRUST_PROXY_HOPS
LOG_CLIENT_IP=false

# rate limits (per minute per user for AI, per hour per IP for register)
AI_RATE_LIMIT_MAX=20
REGISTER_RATE_LIMIT_MAX=10
# failed logins per account (email) per 15 minutes, on top of the per-IP limit
LOGIN_EMAIL_LIMIT_MAX=20

# shown by /api/health. Render supplies RENDER_GIT_COMMIT automatically.
APP_VERSION=

# optional. Leave blank to run classify-ticket on its offline heuristic
# fallback (no external call, no cost). Free key: https://console.groq.com
GROQ_API_KEY=
# model name; change it here if Groq retires one (default openai/gpt-oss-20b). GROQ_MODEL is an older alias.
AI_MODEL=openai/gpt-oss-20b
