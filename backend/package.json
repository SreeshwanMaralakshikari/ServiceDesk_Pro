{
  "name": "servicedeskpro-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "ServiceDesk Pro - IT Helpdesk & Asset Management (backend MVP)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node utils/seedData.js",
    "test": "node --test",
    "test:unit": "node --test \"test/*.test.js\"",
    "test:integration": "node --test --test-concurrency=4 \"test/integration/*.test.js\"",
    "docs": "node scripts/generateDocs.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "sift": "17.1.3",
    "supertest": "^7.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  }
}
